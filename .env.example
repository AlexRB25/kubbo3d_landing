# Copia este archivo como .env.local y rellénalo.

# El mismo proyecto de Supabase que la calculadora, las herramientas y las apps.
PB_SUPABASE_URL=
PB_SUPABASE_PUBLISHABLE_KEY=

# Dominio padre compartido por todos los sitios (por ejemplo .kubbo3d.com). Con él la sesión iniciada aquí
# vale también en calculator.kubbo3d.com y tools.kubbo3d.com. Vacío = .kubbo3d.com cuando el sitio corre ahí.
PB_COOKIE_DOMAIN=

# Dirección de cada servicio, sin diagonal final. Vacías = https://calculator.kubbo3d.com, https://tools.kubbo3d.com
# y https://calculator.kubbo3d.com/tienda al compilar para producción (localhost al desarrollar).
PB_CALCULATOR_URL=http://localhost:3001
PB_TOOLS_URL=http://localhost:3002
# Mientras la tienda siga dentro de la calculadora: la misma dirección + /tienda.
PB_STORE_URL=http://localhost:3001/tienda
# Dirección pública de esta landing (https://kubbo3d.com), para las vistas previas al compartir.
SITE_URL=

# ── Suscripciones con Mercado Pago (solo en el servidor, nunca con PB_) ──
# Access token de producción de tu aplicación de Mercado Pago (Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks). Eventos: "Planes y suscripciones".
# URL del webhook: https://kubbo3d.com/api/mercadopago/webhook
MP_WEBHOOK_SECRET=
# Pesos por dólar con los que se cobran los planes (Mercado Pago solo cobra en pesos en México).
# Ejemplo: 18.5 → el plan de USD 25 se cobra $463 MXN al mes. Si lo cambias, aplica a suscripciones nuevas.
MP_USD_RATE=
# Moneda del cobro: MXN en México.
MP_CURRENCY=MXN
# Llave secreta de Supabase (Project Settings → API Keys → secret): para guardar las suscripciones.
SUPABASE_SECRET_KEY=
